ClassEtu --> Matiere
ClassEtu --> EDT
ClassEtu --> Etudiant
Professeur --> Personne
Professeur --> Matiere
Professeur --> ClassEtu
Professeur --> EDT
Administrateur --> Personne
Actualite --> Date

Context --> Database
Context --> Etudiant
Context --> Professeur
Context --> Administrateur
SchoolFacade --> Database
SchoolFacade --> Etudiant
SchoolFacade --> Professeur
SchoolFacade --> Administrateur
SchoolFacade ..> PersonneDB : utilise
Database ..> PersonneDB : utilise
Database ..> NoteDB : utilise
Database ..> AbsenceDB : utilise
Database ..> MatiereDB : utilise
Database ..> ClasseDB : utilise
Database ..> ClasseMatiereDB : utilise
Database ..> CoursDB : utilise
Database ..> ActualiteDB : utilise

@enduml
